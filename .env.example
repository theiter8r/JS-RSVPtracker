# ---- required everywhere (site + scripts) ----
# Neon/Vercel Postgres connection string
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# Public origin of the deployed site. No trailing slash.
# Local dev: http://localhost:3000
NEXT_PUBLIC_BASE_URL="https://your-app.vercel.app"

# ---- admin dashboard (HTTP Basic auth) ----
ADMIN_USER="raaj"
ADMIN_PASSWORD="pick-a-long-random-password"

# ---- live count display ----
# Path segment for the display page: /count/<COUNT_SECRET>. Anyone with the link
# can watch the headcount, so make it long enough not to be guessed.
# Generate one:  node -e 'console.log(require("crypto").randomBytes(12).toString("base64url"))'
COUNT_SECRET="generate-a-random-string"

# ---- sender only: keep these LOCAL, never set them on Vercel ----
GMAIL_USER="you@gmail.com"
# A 16-character Google App Password (myaccount.google.com → Security → App passwords).
# Requires 2-Step Verification. This is NOT your Gmail password.
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_FROM_NAME="JS Mumbai"
MAIL_REPLY_TO="you@gmail.com"

# Milliseconds between sends. 5000 ≈ 12/min — gentle enough for Gmail.
RATE_MS="5000"

# Optional: point at any other SMTP provider (Resend, SES) without code changes.
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="465"
